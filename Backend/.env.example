APP_NAME=IntelliERP
API_V1_PREFIX=/api/v1
# Development only. Generate a real secret before any deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-development-secret-before-deploying
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_URL=http://localhost:5173

# The business's "today", from which the analytics measure back:
#   auto  - the latest sales order date (default; a loaded dataset then never goes stale)
#   today - the calendar date
#   or a fixed date such as 2026-10-05
BUSINESS_DATE=auto

# Whoever created or submitted a purchase order may not approve it. Set to false to allow it.
SEPARATION_OF_DUTIES=true

# AI assistant. Without the provider's key the assistant page reports that it is not configured.
# Never commit a key.
#   gemini    - Google Gemini; free tier, key from https://aistudio.google.com/apikey
#   anthropic - Anthropic Claude; paid, key from https://platform.claude.com/
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Leave empty for the provider's default: gemini-3.8-flash or claude-opus-5-5
LLM_MODEL=
# Gemini only: models to move on to, in order, when the one in use is overloaded or has used up its
# daily free-tier requests. Each model has its own quota. Empty to disable.
LLM_FALLBACK_MODEL=gemini-3.5-flash,gemini-3.5-flash-lite
# Anthropic only: low | medium | high | xhigh | max
LLM_EFFORT=medium

# Grounding in the knowledge base. Set to false only to measure what it contributes.
LLM_GROUNDING=true

# Proactive scan: minutes between scheduled scans (1440 = daily, 0 = only when run by hand),
# and how many of the most severe findings each scan analyses.
INSIGHT_SCAN_INTERVAL_MINUTES=1440
INSIGHT_MAX_FINDINGS=6

# Where ERP data lives:
#   postgres - PostgreSQL via SQLAlchemy (persistent)
#   memory   - demo data held in RAM, reset on every restart (no database needed)
DATA_BACKEND=postgres
# Local development credentials only; use a strong password anywhere else.
DATABASE_URL=postgresql+psycopg://intellierp:intellierp@localhost:5432/intellierp
